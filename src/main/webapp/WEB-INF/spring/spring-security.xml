<?xml version="1.0" encoding="UTF-8"?>
<beans:beans xmlns="http://www.springframework.org/schema/security"
             xmlns:beans="http://www.springframework.org/schema/beans"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 http://www.springframework.org/schema/security
                 http://www.springframework.org/schema/security/spring-security.xsd
                 http://www.springframework.org/schema/beans
                 http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ===== Public Resources (no auth required) ===== -->
    <http pattern="/resources/**" security="none"/>
    <http pattern="/uploads/**"   security="none"/>

    <!-- ===== Admin Security ===== -->
    <http pattern="/admin/**" use-expressions="true">
        <intercept-url pattern="/admin/login" access="permitAll"/>
        
        <!-- Users Management: Only ADMIN -->
        <intercept-url pattern="/admin/users/**" access="hasRole('ADMIN')"/>
        
        <!-- Reports: ADMIN and STORE_MANAGER -->
        <intercept-url pattern="/admin/reports/**" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        
        <!-- Categories Write Operations: ADMIN and STORE_MANAGER -->
        <intercept-url pattern="/admin/categories/*/delete" access="hasRole('ADMIN')"/>
        <intercept-url pattern="/admin/categories/new" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/categories/save" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/categories/*/edit" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/categories/*/update" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        
        <!-- Categories View Operations: ADMIN, STORE_MANAGER, SALES_STAFF -->
        <intercept-url pattern="/admin/categories" access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF')"/>
        
        <!-- Products Write Operations: ADMIN and STORE_MANAGER -->
        <intercept-url pattern="/admin/products/*/delete" access="hasRole('ADMIN')"/>
        <intercept-url pattern="/admin/products/new" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/products/save" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/products/*/edit" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/products/*/update" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/products/*/toggle-status" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        <intercept-url pattern="/admin/products/*/toggle-featured" access="hasAnyRole('ADMIN','STORE_MANAGER')"/>
        
        <!-- Products View Operations: ADMIN, STORE_MANAGER, SALES_STAFF, WAREHOUSE_STAFF -->
        <intercept-url pattern="/admin/products" access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        
        <!-- Orders Management: ADMIN, STORE_MANAGER, SALES_STAFF -->
        <intercept-url pattern="/admin/orders/**" access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF')"/>
        
        <!-- General Admin Dashboard & Home: ADMIN, STORE_MANAGER, SALES_STAFF, WAREHOUSE_STAFF -->
        <intercept-url pattern="/admin/dashboard" access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <intercept-url pattern="/admin" access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <intercept-url pattern="/admin/**"    access="hasAnyRole('ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <form-login login-page="/admin/login"
                    login-processing-url="/admin/login"
                    default-target-url="/admin/dashboard"
                    authentication-failure-url="/admin/login?error=true"
                    username-parameter="username"
                    password-parameter="password"/>
        <logout logout-url="/admin/logout"
                logout-success-url="/admin/login?logout=true"
                invalidate-session="true"/>
        <session-management>
            <concurrency-control max-sessions="1" expired-url="/admin/login?expired=true"/>
        </session-management>
        <csrf disabled="false"/>
    </http>

    <!-- ===== Customer Security ===== -->
    <http use-expressions="true">
        <intercept-url pattern="/login"    access="permitAll"/>
        <intercept-url pattern="/register" access="permitAll"/>
        <intercept-url pattern="/home"     access="permitAll"/>
        <intercept-url pattern="/"         access="permitAll"/>
        <intercept-url pattern="/index.jsp" access="permitAll"/>
        <intercept-url pattern="/health"    access="permitAll"/>
        <intercept-url pattern="/db-status"  access="permitAll"/>
        <intercept-url pattern="/shop/**"  access="permitAll"/>
        <intercept-url pattern="/product/**" access="permitAll"/>
        <intercept-url pattern="/tracking" access="permitAll"/>
        <intercept-url pattern="/cart"     access="permitAll"/>
        <intercept-url pattern="/cart/**"  access="permitAll"/>
        <intercept-url pattern="/checkout" access="hasAnyRole('CUSTOMER','ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <intercept-url pattern="/checkout/**" access="hasAnyRole('CUSTOMER','ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <intercept-url pattern="/orders/**"   access="hasAnyRole('CUSTOMER','ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <intercept-url pattern="/account/**"  access="hasAnyRole('CUSTOMER','ADMIN','STORE_MANAGER','SALES_STAFF','WAREHOUSE_STAFF')"/>
        <form-login login-page="/login"
                    login-processing-url="/login"
                    default-target-url="/shop"
                    authentication-failure-url="/login?error=true"
                    username-parameter="username"
                    password-parameter="password"/>
        <logout logout-url="/logout"
                logout-success-url="/login?logout=true"
                invalidate-session="true"/>
        <session-management>
            <concurrency-control max-sessions="5"/>
        </session-management>
        <csrf disabled="false"/>
    </http>

    <!-- ===== Authentication Provider ===== -->
    <authentication-manager>
        <authentication-provider user-service-ref="customUserDetailsService">
            <password-encoder ref="passwordEncoder"/>
        </authentication-provider>
    </authentication-manager>

    <!-- ===== BCrypt Password Encoder ===== -->
    <beans:bean id="passwordEncoder"
                class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder">
        <beans:constructor-arg value="12"/>
    </beans:bean>
</beans:beans>
